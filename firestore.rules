rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    match /awards_nominations/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly([
          'nomination', 'nomination_lower', 'category',
          'street', 'street_lower', 'pincode',
          'area', 'area_suggested', 'owner_name', 'business_phone',
          'nominated_by', 'video_url', 'votes', 'source', 'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'nomination', 'nomination_lower', 'category',
          'street', 'street_lower', 'pincode',
          'area', 'area_suggested', 'owner_name', 'business_phone',
          'nominated_by', 'video_url', 'votes', 'source', 'created_at'
        ])
        && request.resource.data.nomination is string
        && request.resource.data.nomination_lower is string
        && request.resource.data.category is string
        && request.resource.data.street is string
        && request.resource.data.street_lower is string
        && request.resource.data.pincode is string
        && request.resource.data.area is string
        && request.resource.data.area_suggested is string
        && request.resource.data.owner_name is string
        && request.resource.data.business_phone is string
        && request.resource.data.nominated_by is string
        && request.resource.data.video_url is string
        && request.resource.data.votes is number
        && request.resource.data.source is string
        && request.resource.data.created_at is timestamp
        && request.resource.data.nomination.size() >= 3
        && request.resource.data.nomination.size() <= 99
        && request.resource.data.nomination_lower == request.resource.data.nomination.lower()
        && request.resource.data.street.size() <= 200
        && request.resource.data.street_lower == request.resource.data.street.lower()
        && request.resource.data.pincode.matches('^[0-9]{6}$')
        && request.resource.data.area.size() <= 100
        && request.resource.data.area_suggested.size() <= 100
        && request.resource.data.owner_name.size() <= 100
        && request.resource.data.business_phone.size() <= 20
        && request.resource.data.nominated_by.size() <= 20
        && request.resource.data.video_url.size() <= 500
        && request.resource.data.category in [
          'Provisions', 'Restaurant', 'Sweet shop', 'Textiles', 'Medical store',
          'Stainless steel', 'Hardware', 'Salon', 'Electronics', 'Tea shop',
          'Bakery', 'Pharmacy', 'Printing', 'Jewelry', 'Stationery',
          'Sari shop', 'Mobile shop', 'Flower shop', 'Coffee shop', 'Other'
        ]
        && request.resource.data.votes == 0
        && request.resource.data.source == 'web';
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                 && request.resource.data.votes == resource.data.votes + 1;
      allow delete: if false;
    }

    match /awards_votes/{id} {
      allow read: if false;
      allow create: if request.resource.data.nomination_id is string
                 && request.resource.data.voter is string
                 && request.resource.data.pincode is string;
      allow update, delete: if false;
    }

    match /businesses/{id} {
      allow read: if true;
      allow update: if request.auth != null
                 && request.auth.token.firebase.sign_in_provider == 'phone'
                 && (
                    (
                      resource.data.claimed != true
                      && request.resource.data.claimed == true
                      && request.resource.data.claimed_by_phone is string
                      && request.resource.data.claimed_by_phone == request.auth.token.phone_number
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                           ['claimed', 'claimed_by_phone', 'claimed_by_name', 'claimed_at', 'verified']
                         )
                      && request.resource.data.claimed_at is timestamp
                    )
                    ||
                    (
                      resource.data.claimed == true
                      && resource.data.claimed_by_phone == request.auth.token.phone_number
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                           ['owner_phone', 'owner_hours', 'owner_description', 'owner_whatsapp', 'owner_website', 'owner_instagram', 'owner_edited_at']
                         )
                      && (!('owner_description' in request.resource.data) || request.resource.data.owner_description.size() <= 500)
                      && (!('owner_hours' in request.resource.data) || request.resource.data.owner_hours.size() <= 100)
                    )
                 );
      allow create, delete: if false;
    }

    match /claim_audit/{id} {
      allow create: if request.auth != null
                 && request.auth.token.firebase.sign_in_provider == 'phone';
      allow read, update, delete: if false;
    }

    match /analytics_events/{id} {
      allow create: if
        request.resource.data.keys().size() <= 10
        && request.resource.data.event is string
        && request.resource.data.event.size() <= 50
        && request.resource.data.event in [
          'pincode_view', 'shop_view', 'whatsapp_click',
          'call_click', 'share_click', 'nominate_click',
          'claim_click', 'premium_click'
        ];
      allow read: if request.auth != null
                 && request.auth.token.firebase.sign_in_provider == 'phone';
      allow update, delete: if false;
    }

    match /payments/{id} {
      allow read: if request.auth != null
                 && request.auth.token.firebase.sign_in_provider == 'phone';
      allow write: if false;
    }

    match /feed/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}